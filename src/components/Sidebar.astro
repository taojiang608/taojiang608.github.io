---
import ThemeToggle from "./ThemeToggle.astro";
import SocialLinks from "./SocialLinks.astro";

const navLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about/" },
  { label: "Projects", href: "/projects/" },
  { label: "Blog", href: "/blog/" },
];

const currentPath = Astro.url.pathname;
---

<!-- Mobile header -->
<header
  class="fixed top-0 right-0 left-0 z-50 flex items-center justify-between border-b border-gray-200 bg-white/80 px-4 py-3 backdrop-blur-lg lg:hidden dark:border-gray-800 dark:bg-gray-950/80"
>
  <a href="/" class="flex items-center gap-3">
    <img
      src="/images/avatar.jpeg"
      alt="Tao Jiang"
      class="h-8 w-8 rounded-full object-cover"
      width="32"
      height="32"
    />
    <span class="font-semibold text-gray-900 dark:text-white">Tao Jiang</span>
  </a>
  <div class="flex items-center gap-2">
    <ThemeToggle />
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="rounded-lg p-2 text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800"
    >
      <svg
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile menu overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 hidden bg-gray-900/50 backdrop-blur-sm lg:hidden"
  role="dialog"
  aria-modal="true"
>
  <nav
    class="ml-auto flex h-full w-72 flex-col bg-white p-6 shadow-xl dark:bg-gray-950"
  >
    <button
      id="mobile-menu-close"
      type="button"
      aria-label="Close navigation menu"
      class="mb-8 self-end rounded-lg p-2 text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800"
    >
      <svg
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <ul class="space-y-1">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "block rounded-lg px-4 py-2.5 text-sm font-medium transition-colors",
                currentPath === link.href
                  ? "bg-primary-50 text-primary-700 dark:bg-primary-950 dark:text-primary-300"
                  : "text-gray-600 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-900 dark:hover:text-gray-100",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-auto pt-6">
      <SocialLinks />
    </div>
  </nav>
</div>

<!-- Desktop sidebar -->
<aside
  class="fixed top-0 left-0 z-30 hidden h-screen w-72 flex-col border-r border-gray-200 bg-gray-50/50 p-8 lg:flex dark:border-gray-800 dark:bg-gray-900/50"
>
  <div class="mb-10 text-center">
    <a href="/" class="group inline-block">
      <img
        src="/images/avatar.jpeg"
        alt="Tao Jiang"
        class="mx-auto mb-4 h-28 w-28 rounded-full object-cover ring-2 ring-gray-200 transition-all group-hover:ring-primary-400 dark:ring-gray-700"
        width="112"
        height="112"
        loading="eager"
      />
      <h1
        class="text-xl font-bold text-gray-900 transition-colors group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400"
      >
        Tao Jiang
      </h1>
    </a>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Data Scientist @ Genentech
    </p>
  </div>

  <nav class="flex-1">
    <ul class="space-y-1">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "block rounded-lg px-4 py-2.5 text-sm font-medium transition-colors",
                currentPath === link.href
                  ? "bg-primary-50 text-primary-700 dark:bg-primary-950 dark:text-primary-300"
                  : "text-gray-600 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-900 dark:hover:text-gray-100",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="space-y-4 border-t border-gray-200 pt-6 dark:border-gray-800">
    <SocialLinks />
    <div class="flex items-center justify-between">
      <span class="text-xs text-gray-400 dark:text-gray-600"
        >&copy; {new Date().getFullYear()} Tao Jiang</span
      >
      <ThemeToggle />
    </div>
  </div>
</aside>

<script>
  const btn = document.getElementById("mobile-menu-btn")!;
  const menu = document.getElementById("mobile-menu")!;
  const close = document.getElementById("mobile-menu-close")!;

  function openMenu() {
    menu.classList.remove("hidden");
    btn.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    menu.classList.add("hidden");
    btn.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  btn.addEventListener("click", openMenu);
  close.addEventListener("click", closeMenu);
  menu.addEventListener("click", (e) => {
    if (e.target === menu) closeMenu();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
</script>
