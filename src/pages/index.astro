---
import PageLayout from "@/layouts/PageLayout.astro";

const news = [
  {
    date: "September 2020",
    text: 'Our paper <a href="https://academic.oup.com/bioinformatics/article/37/7/976/5910548" class="text-primary-600 dark:text-primary-400 underline decoration-primary-300 dark:decoration-primary-700 underline-offset-2 hover:decoration-primary-500 transition-colors" target="_blank" rel="noopener">Knockoff boosted tree for model-free variable selection</a> was published on <em>Bioinformatics</em>.',
  },
  {
    date: "March 2020",
    text: 'Joined the late phase solid tumor (oncology) team at <a href="https://www.gene.com/" class="text-primary-600 dark:text-primary-400 underline decoration-primary-300 dark:decoration-primary-700 underline-offset-2 hover:decoration-primary-500 transition-colors" target="_blank" rel="noopener">Genentech</a>, South San Francisco, CA.',
  },
  {
    date: "February 2020",
    text: 'Defended PhD dissertation: <a href="https://repository.lib.ncsu.edu/bitstream/handle/1840.20/37296/etd.pdf?sequence=1" class="text-primary-600 dark:text-primary-400 underline decoration-primary-300 dark:decoration-primary-700 underline-offset-2 hover:decoration-primary-500 transition-colors" target="_blank" rel="noopener">High Dimensional Linear and Tree-based Models in Bioinformatics</a>.',
  },
];
---

<PageLayout title="Tao Jiang — Statistical Scientist">
  <!-- Hero -->
  <section class="mb-16">
    <h1
      class="mb-6 text-4xl font-bold tracking-tight text-gray-900 dark:text-white"
    >
      Welcome to Tao's homepage!
    </h1>
    <p class="text-lg leading-relaxed text-gray-600 dark:text-gray-300">
      Hi, I am Tao Jiang, a data scientist at <a
        href="https://www.gene.com/"
        class="text-primary-600 underline decoration-primary-300 underline-offset-2 transition-colors hover:decoration-primary-500 dark:text-primary-400 dark:decoration-primary-700"
        target="_blank"
        rel="noopener">Genentech</a
      >, a member of the Roche group. I am interested in machine learning,
      bioinformatics, and causal inference. I got my PhD degree in Statistics and
      Bioinformatics at North Carolina State University, advised by Dr. <a
        href="https://scholar.google.com/citations?user=exnyU4QAAAAJ&hl=en"
        class="text-primary-600 underline decoration-primary-300 underline-offset-2 transition-colors hover:decoration-primary-500 dark:text-primary-400 dark:decoration-primary-700"
        target="_blank"
        rel="noopener">Alison Motsinger-Reif</a
      >.
    </p>
  </section>

  <!-- News -->
  <section>
    <h2
      class="mb-6 text-2xl font-semibold text-gray-900 dark:text-white"
    >
      News & Updates
    </h2>
    <div class="space-y-0 divide-y divide-gray-100 dark:divide-gray-800">
      {
        news.map((item) => (
          <div class="flex flex-col gap-1 py-4 sm:flex-row sm:gap-6">
            <time class="shrink-0 text-sm font-medium text-primary-600 dark:text-primary-400 sm:w-36">
              {item.date}
            </time>
            <p
              class="text-gray-600 dark:text-gray-300"
              set:html={item.text}
            />
          </div>
        ))
      }
    </div>
  </section>
</PageLayout>
