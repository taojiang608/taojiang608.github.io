---
import PageLayout from "@/layouts/PageLayout.astro";
---

<PageLayout title="Page Not Found — Tao Jiang">
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <h1 class="text-6xl font-bold text-gray-300 dark:text-gray-700">404</h1>
    <p class="mt-4 text-xl text-gray-600 dark:text-gray-400">Page not found</p>
    <a
      href="/"
      class="mt-8 rounded-lg bg-primary-600 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-primary-700"
    >
      Go home
    </a>
  </div>
</PageLayout>
