---
import PageLayout from "@/layouts/PageLayout.astro";

const projects = [
  {
    title: "Knockoff Boosted Tree",
    description:
      "A model-free variable selection method combining knockoff filters with gradient boosted trees for high-dimensional data analysis.",
    tags: ["Machine Learning", "Variable Selection", "R"],
    link: "https://academic.oup.com/bioinformatics/article/37/7/976/5910548",
  },
  {
    title: "Histociation",
    description:
      "A visual exploration of historical associations between Ancient Greece and Ancient China — comparing timelines of philosophers, currencies, and cultural milestones.",
    tags: ["Data Visualization", "History"],
    link: "https://medium.com/@tao.jiang608/histociation-ancient-greece-and-ancient-china-54494078fe28",
  },
];
---

<PageLayout
  title="Projects — Tao Jiang"
  description="Research projects and publications by Tao Jiang."
>
  <h1
    class="mb-6 text-4xl font-bold tracking-tight text-gray-900 dark:text-white"
  >
    Projects
  </h1>
  <p class="mb-10 text-gray-600 dark:text-gray-300">
    Selected research projects and publications.
  </p>

  <div class="space-y-6">
    {
      projects.map((project) => (
        <a
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group block rounded-xl border border-gray-200 p-6 transition-all hover:border-primary-300 hover:shadow-lg hover:shadow-primary-100/50 dark:border-gray-800 dark:hover:border-primary-700 dark:hover:shadow-primary-900/20"
        >
          <h2 class="mb-2 text-xl font-semibold text-gray-900 transition-colors group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400">
            {project.title}
            <svg
              class="mb-0.5 ml-1 inline-block h-4 w-4 opacity-0 transition-opacity group-hover:opacity-100"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
              />
            </svg>
          </h2>
          <p class="mb-4 text-gray-600 dark:text-gray-400">
            {project.description}
          </p>
          <div class="flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</PageLayout>
